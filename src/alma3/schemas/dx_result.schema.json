{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almagenomics.com/schemas/alma3/dx_result.schema.json",
  "title": "ALMA3 diagnostic result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "sample_id",
    "result_summary",
    "release",
    "runtime",
    "input",
    "observed_cpg_count",
    "minimum_observed_cpgs",
    "status",
    "accepted",
    "path",
    "decision"
  ],
  "properties": {
    "kind": {"const": "alma3_dx_result"},
    "schema_version": {"const": 2},
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![=+@-])(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f]+$"
    },
    "result_summary": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
    "release": {"$ref": "#/$defs/release"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "input": {"$ref": "#/$defs/input"},
    "observed_cpg_count": {"type": "integer", "minimum": 1},
    "minimum_observed_cpgs": {"type": "integer", "minimum": 1},
    "status": {
      "enum": ["no_call", "heme_tumor_not_detected", "fully_resolved", "partially_resolved"]
    },
    "accepted": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identityNode"}
      ]
    },
    "path": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/pathNode"}
    },
    "decision": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/unresolvedDecision"}
      ]
    }
  },
  "$defs": {
    "level": {
      "enum": ["presence", "lineage", "family", "type", "subtype"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifest_sha256",
        "model_sha256",
        "taxonomy_sha256",
        "cpg_manifest_sha256",
        "thresholds_sha256"
      ],
      "properties": {
        "version": {"const": "3.0.0"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "taxonomy_sha256": {"$ref": "#/$defs/sha256"},
        "cpg_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "thresholds_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_version", "contract_sha256", "device"],
      "properties": {
        "package_version": {"const": "3.0.0"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "device": {"type": "string", "pattern": "^(cpu|cuda:(0|[1-9][0-9]*))$"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "value_mode", "clipped_value_count"],
      "properties": {
        "format": {"enum": ["array", "array-csv", "bedmethyl"]},
        "value_mode": {"enum": ["beta", "mvalue", "fraction_modified"]},
        "modification_mode": {"enum": ["5mc", "5mc_plus_5hmc"]},
        "clipped_value_count": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {
          "properties": {
            "format": {"enum": ["array", "array-csv"]},
            "value_mode": {"const": "beta"}
          },
          "not": {"required": ["modification_mode"]}
        },
        {
          "properties": {
            "format": {"enum": ["array", "array-csv"]},
            "value_mode": {"const": "mvalue"},
            "clipped_value_count": {"const": 0}
          },
          "not": {"required": ["modification_mode"]}
        },
        {
          "properties": {
            "format": {"const": "bedmethyl"},
            "value_mode": {"const": "fraction_modified"},
            "clipped_value_count": {"const": 0}
          },
          "required": ["modification_mode"]
        }
      ]
    },
    "identityNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "index", "classification"],
      "properties": {
        "level": {"$ref": "#/$defs/level"},
        "index": {"type": "integer", "minimum": 0},
        "classification": {"type": "string", "minLength": 1}
      }
    },
    "pathNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "index", "classification", "model_score", "reporting_cutoff"],
      "properties": {
        "level": {"$ref": "#/$defs/level"},
        "status": {"enum": ["resolved", "implied"]},
        "index": {"type": "integer", "minimum": 0},
        "classification": {"type": "string", "minLength": 1},
        "model_score": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/probability"}
          ]
        },
        "reporting_cutoff": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/probability"}
          ]
        }
      }
    },
    "unresolvedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "reporting_cutoff", "differential"],
      "properties": {
        "level": {"$ref": "#/$defs/level"},
        "status": {"const": "unresolved"},
        "reporting_cutoff": {"$ref": "#/$defs/probability"},
        "differential": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/differentialEntry"}
        }
      }
    },
    "differentialEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "classification", "model_score"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "classification": {"type": "string", "minLength": 1},
        "model_score": {"$ref": "#/$defs/probability"}
      }
    }
  }
}
