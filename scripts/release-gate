#!/usr/bin/env python3
from __future__ import annotations

import argparse
import contextlib
import csv
import ctypes
import gzip
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import uuid
import zipfile
from collections.abc import Iterator
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
FORBIDDEN_NAMES = {".safetensors", ".pt", ".pth", ".h5", ".hdf5"}
FORBIDDEN_TEXT = (b"/home/", b"/data/", b"pac" + b"map", b"fai" + b"ss")
PYTHON_IMAGES = {
    "3.10": "python:3.10-slim-bookworm",
    "3.11": "python:3.11-slim-bookworm",
    "3.12": None,
}
DEMO_GZIP_SHA256 = "c7fd2afcba9b4830b9774cc646ccd060c7d48de9b0002fb9bebf77e551e45a37"
DEMO_MANIFEST_SHA256 = "1ee42be811e5373d28ed6a2cd8bea895ea1df574fdb1de520e2f77d13354bcee"
DEMO_MANIFEST = "alma3/examples/example_dataset.manifest.json"
BEDMETHYL_TARGET = "alma3/assets/alma3-3.0.0-grch38-projectable-cpgs.bed.gz"
BEDMETHYL_TARGET_GZIP_SHA256 = "c79f88affdb2848a85741d416b7b723b5c08077ee8948962114a666cfd23b7ac"
BEDMETHYL_TARGET_SHA256 = "3e6feef17fc4813caf4186c63d63165e7ddb77a0c3b31c93a2a33ddf6eec916a"
BEDMETHYL_TARGET_CPG_COUNT = 65_535
CANDIDATE_KIND = "alma3_release_candidate_acceptance"
CANDIDATE_SCHEMA_VERSION = 1
CANDIDATE_MARKER = "ACCEPTANCE_COMPLETE"


def run(command: list[str], *, env: dict[str, str] | None = None) -> None:
    print("+", " ".join(command), flush=True)
    subprocess.run(command, cwd=ROOT, env=env, check=True)


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(16 * 1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _canonical_json(payload: Any) -> bytes:
    return (json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()


def _write_new(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())


def _copy_new(source: Path, destination: Path) -> str:
    destination.parent.mkdir(parents=True, exist_ok=True)
    digest = hashlib.sha256()
    try:
        with source.open("rb") as source_handle, destination.open("xb") as destination_handle:
            for block in iter(lambda: source_handle.read(16 * 1024 * 1024), b""):
                digest.update(block)
                destination_handle.write(block)
            destination_handle.flush()
            os.fsync(destination_handle.fileno())
    except BaseException:
        destination.unlink(missing_ok=True)
        raise
    return digest.hexdigest()


def _fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _publish_new_directory(temporary: Path, destination: Path) -> None:
    """Atomically publish a same-filesystem Linux directory without replacement."""

    libc = ctypes.CDLL(None, use_errno=True)
    try:
        renameat2 = libc.renameat2
    except AttributeError as error:
        raise RuntimeError("release candidates require Linux renameat2") from error
    renameat2.argtypes = (
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    )
    renameat2.restype = ctypes.c_int
    if renameat2(-100, os.fsencode(temporary), -100, os.fsencode(destination), 1) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), str(destination))
    _fsync_directory(destination.parent)


@contextlib.contextmanager
def _atomic_candidate(output: Path) -> Iterator[Path]:
    destination = output.resolve()
    if destination.exists() or destination.is_symlink():
        raise FileExistsError(f"release candidate already exists: {destination}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.parent / f".{destination.name}.tmp-{uuid.uuid4().hex}"
    temporary.mkdir(mode=0o700)
    try:
        yield temporary
        _fsync_directory(temporary)
        _publish_new_directory(temporary, destination)
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)


def _git_text(*arguments: str) -> str:
    completed = subprocess.run(
        ["git", *arguments],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    return completed.stdout.strip()


def _source_identity() -> dict[str, Any]:
    branch = _git_text("branch", "--show-current")
    commit = _git_text("rev-parse", "HEAD")
    origin_main = _git_text("rev-parse", "origin/main")
    status = _git_text("status", "--porcelain=v1", "--untracked-files=all")
    if branch != "main":
        raise RuntimeError(f"release candidate requires main; found {branch or 'detached HEAD'}")
    if status:
        raise RuntimeError("release candidate requires a clean source checkout")
    if commit != origin_main:
        raise RuntimeError("release candidate requires HEAD == origin/main")
    return {
        "branch": branch,
        "commit": commit,
        "head_equals_origin_main": True,
        "worktree_clean": True,
    }


def _citation_value() -> str:
    readme = (ROOT / "README.md").read_text(encoding="utf-8")
    start = "<details><summary><strong>Citation</strong></summary>"
    if readme.count(start) != 1:
        raise RuntimeError("README must contain exactly one Citation section")
    value = readme.split(start, 1)[1].split("</details>", 1)[0].strip()
    if not value:
        raise RuntimeError("README Citation section is empty")
    return value


def _image_identity(tag: str) -> dict[str, Any]:
    completed = subprocess.run(
        ["docker", "image", "inspect", "--platform", "linux/amd64", tag],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    images = json.loads(completed.stdout)
    if not isinstance(images, list) or len(images) != 1:
        raise RuntimeError(f"Docker returned an invalid image identity for {tag}")
    image = images[0]
    identity = {
        "architecture": image.get("Architecture"),
        "image_id": image.get("Id"),
        "operating_system": image.get("Os"),
        "size_bytes": image.get("Size"),
        "tag": tag,
    }
    if (
        identity["architecture"] != "amd64"
        or identity["operating_system"] != "linux"
        or not isinstance(identity["image_id"], str)
        or not identity["image_id"].startswith("sha256:")
        or type(identity["size_bytes"]) is not int
        or identity["size_bytes"] <= 0
    ):
        raise RuntimeError(f"Docker image has an invalid release identity: {identity}")
    return identity


def _archive_config_id(path: Path) -> str:
    with tarfile.open(path, mode="r") as archive:
        try:
            manifest_file = archive.extractfile("manifest.json")
        except KeyError as error:
            raise RuntimeError("Docker archive is missing manifest.json") from error
        if manifest_file is None:
            raise RuntimeError("Docker archive manifest is unreadable")
        manifests = json.load(manifest_file)
        if not isinstance(manifests, list) or len(manifests) != 1:
            raise RuntimeError("Docker archive must contain exactly one image")
        config_name = manifests[0].get("Config") if isinstance(manifests[0], dict) else None
        if not isinstance(config_name, str) or not config_name:
            raise RuntimeError("Docker archive image config is invalid")
        try:
            config_file = archive.extractfile(config_name)
        except KeyError as error:
            raise RuntimeError("Docker archive is missing its image config") from error
        if config_file is None:
            raise RuntimeError("Docker archive image config is unreadable")
        return f"sha256:{hashlib.sha256(config_file.read()).hexdigest()}"


def inspect_wheel(wheel: Path) -> None:
    with zipfile.ZipFile(wheel) as archive:
        names = {info.filename for info in archive.infolist()}
        if "alma3/py.typed" not in names:
            raise RuntimeError("wheel is missing the PEP 561 marker")
        if "alma3/examples/example_dataset.csv.gz" not in names:
            raise RuntimeError("wheel is missing the packaged demo")
        if DEMO_MANIFEST not in names:
            raise RuntimeError("wheel is missing the packaged demo manifest")
        if (
            hashlib.sha256(archive.read("alma3/examples/example_dataset.csv.gz")).hexdigest()
            != DEMO_GZIP_SHA256
        ):
            raise RuntimeError("wheel demo SHA-256 mismatch")
        if hashlib.sha256(archive.read(DEMO_MANIFEST)).hexdigest() != DEMO_MANIFEST_SHA256:
            raise RuntimeError("wheel demo manifest SHA-256 mismatch")
        if BEDMETHYL_TARGET not in names:
            raise RuntimeError("wheel is missing the release-bound BedMethyl target")
        target_gzip = archive.read(BEDMETHYL_TARGET)
        if hashlib.sha256(target_gzip).hexdigest() != BEDMETHYL_TARGET_GZIP_SHA256:
            raise RuntimeError("wheel BedMethyl target gzip SHA-256 mismatch")
        try:
            target = gzip.decompress(target_gzip)
        except (OSError, EOFError) as error:
            raise RuntimeError("wheel BedMethyl target is not valid gzip") from error
        if hashlib.sha256(target).hexdigest() != BEDMETHYL_TARGET_SHA256:
            raise RuntimeError("wheel BedMethyl target SHA-256 mismatch")
        if len(target.splitlines()) != BEDMETHYL_TARGET_CPG_COUNT:
            raise RuntimeError("wheel BedMethyl target row count mismatch")
        for info in archive.infolist():
            name = info.filename.lower()
            if Path(name).suffix in FORBIDDEN_NAMES:
                raise RuntimeError(f"wheel contains forbidden binary: {info.filename}")
            if info.file_size <= 2 * 1024 * 1024:
                content = archive.read(info).lower()
                for forbidden in FORBIDDEN_TEXT:
                    if forbidden in content:
                        raise RuntimeError(f"wheel contains forbidden text {forbidden!r}: {info.filename}")


def runtime_contract(package_root: Path) -> str:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.hashes import runtime_contract_sha256

    return runtime_contract_sha256(package_root)


def inspect_paired_results(jsonl: Path, csv_path: Path, manifest_path: Path | None = None) -> None:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.clinical_result import validate_result
    from alma3.infer import _RESULT_CSV_FIELDS, _result_csv_row

    json_rows = [
        json.loads(line)
        for line in jsonl.read_text(encoding="utf-8").splitlines()
    ]
    with csv_path.open(encoding="utf-8", newline="") as handle:
        reader = csv.DictReader(handle)
        csv_rows = list(reader)
    if tuple(reader.fieldnames or ()) != _RESULT_CSV_FIELDS:
        raise RuntimeError("paired demo CSV header does not match the 45-column contract")
    if not json_rows or len(json_rows) != len(csv_rows):
        raise RuntimeError("paired demo outputs are empty or have different row counts")
    for row in json_rows:
        validate_result(row)
    expected_csv_rows = [
        {
            field: "" if value == "" else str(value)
            for field, value in _result_csv_row(row).items()
        }
        for row in json_rows
    ]
    if expected_csv_rows != csv_rows:
        raise RuntimeError("paired JSONL and CSV demo results are inconsistent")
    if manifest_path is None:
        return
    expected = json.loads(manifest_path.read_text(encoding="utf-8"))["samples"]
    observed = [
        {
            "sample_id": row["sample_id"],
            "observed_cpg_count": row["observed_cpg_count"],
            "expected_status": row["status"],
            "accepted_level": None if row["accepted"] is None else row["accepted"]["level"],
            "accepted_classification": (
                None if row["accepted"] is None else row["accepted"]["classification"]
            ),
            "unresolved_level": None if row["decision"] is None else row["decision"]["level"],
            "result_summary": row["result_summary"],
        }
        for row in json_rows
    ]
    expected = [
        {key: value for key, value in row.items() if key != "selection_role"}
        for row in expected
    ]
    if observed != expected:
        raise RuntimeError("demo results disagree with the packaged manifest")


def inspect_release_catalog(release: Path) -> dict[str, Any]:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.download import _release_spec, _validate_catalog_files
    from alma3.release import validate_release

    _validate_catalog_files(release, _release_spec())
    return validate_release(release, device="cpu", load_model=False)


def inspect_demo(release: Path) -> None:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.infer import _array_csv_batches, demo_path
    from alma3.release import validate_release

    validated = validate_release(release, device="cpu", load_model=False)
    path = demo_path()
    manifest_path = path.with_name("example_dataset.manifest.json")
    payload = path.read_bytes()
    if hashlib.sha256(payload).hexdigest() != DEMO_GZIP_SHA256:
        raise RuntimeError("packaged demo gzip SHA-256 mismatch")
    if hashlib.sha256(manifest_path.read_bytes()).hexdigest() != DEMO_MANIFEST_SHA256:
        raise RuntimeError("packaged demo manifest SHA-256 mismatch")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest["kind"] != "alma3_demo_dataset_manifest" or manifest["schema_version"] != 1:
        raise RuntimeError("packaged demo manifest contract is invalid")
    dataset = manifest["dataset"]
    if (
        dataset["compressed_sha256"] != DEMO_GZIP_SHA256
        or dataset["compressed_bytes"] != len(payload)
        or dataset["sample_count"] != 16
        or dataset["cpg_count"] != 65_536
        or len(payload) > 2_500_000
    ):
        raise RuntimeError("packaged demo metadata is invalid")
    with gzip.GzipFile(fileobj=io.BytesIO(payload), mode="rb") as handle:
        decompressed = handle.read()
    if hashlib.sha256(decompressed).hexdigest() != dataset["decompressed_sha256"]:
        raise RuntimeError("packaged demo decompressed SHA-256 mismatch")
    deterministic = io.BytesIO()
    with gzip.GzipFile(filename="", fileobj=deterministic, mode="wb", compresslevel=9, mtime=0) as handle:
        handle.write(decompressed)
    if deterministic.getvalue() != payload:
        raise RuntimeError("packaged demo gzip is not deterministic")
    expected_release = {
        "version": validated["release"]["version"],
        "manifest_sha256": validated["manifest_sha256"],
        "model_sha256": validated["hashes"]["model.safetensors"],
        "taxonomy_sha256": validated["hashes"]["taxonomy.json"],
        "cpg_manifest_sha256": validated["hashes"]["cpg_manifest.json"],
        "thresholds_sha256": validated["hashes"]["thresholds.json"],
    }
    if manifest["release"] != expected_release:
        raise RuntimeError("packaged demo is bound to a different release")
    reader = csv.reader(io.StringIO(decompressed.decode("utf-8"), newline=""))
    header = next(reader)
    rows = list(reader)
    if header != ["sample_id", *validated["cpg"].cpg_ids]:
        raise RuntimeError("packaged demo CpG columns do not match the release")
    expected_ids = [f"demo_{index:02d}" for index in range(1, 17)]
    if [row[0] for row in rows] != expected_ids or any(len(row) != len(header) for row in rows):
        raise RuntimeError("packaged demo sample rows are invalid")
    parsed = []
    for sample_ids, _, observed, summary in _array_csv_batches(
            demo_path(),
            validated["cpg"],
            input_values="beta",
            minimum_observed_cpgs=int(validated["thresholds"]["minimum_observed_cpgs"]),
        ):
        parsed.extend(
            (sample_id, int(mask.sum().item()), clipped)
            for sample_id, mask, clipped in zip(
                sample_ids, observed, summary.clipped_by_sample, strict=True
            )
        )
    expected_counts = [row["observed_cpg_count"] for row in manifest["samples"]]
    if [sample_id for sample_id, _, _ in parsed] != expected_ids:
        raise RuntimeError("packaged demo parser changed sample order")
    if [count for _, count, _ in parsed] != expected_counts or any(clipped for _, _, clipped in parsed):
        raise RuntimeError("packaged demo coverage or clipping disagrees with its manifest")
    public_text = decompressed.decode("utf-8") + manifest_path.read_text(encoding="utf-8")
    if re.search(r"(?:GSE|GSM|E-MTAB-)[0-9]+", public_text, flags=re.IGNORECASE):
        raise RuntimeError("packaged demo exposes a source accession")


def _release_identity(release: Path) -> dict[str, Any]:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.download import _release_spec

    validated = inspect_release_catalog(release)
    spec = _release_spec()
    return {
        "cpg_manifest_sha256": validated["hashes"]["cpg_manifest.json"],
        "files": spec["files"],
        "manifest_sha256": validated["manifest_sha256"],
        "model_sha256": validated["hashes"]["model.safetensors"],
        "release_metadata": validated["release"],
        "taxonomy_sha256": validated["hashes"]["taxonomy.json"],
        "thresholds_sha256": validated["hashes"]["thresholds.json"],
        "version": validated["release"]["version"],
    }


def _verify_candidate(candidate: Path) -> dict[str, Any]:
    if not candidate.is_dir() or candidate.is_symlink():
        raise RuntimeError("release candidate must be a real directory")
    paths = list(candidate.rglob("*"))
    if any(path.is_symlink() for path in paths):
        raise RuntimeError("release candidate must not contain symbolic links")
    files = {path.relative_to(candidate).as_posix() for path in paths if path.is_file()}
    directories = {path.relative_to(candidate).as_posix() for path in paths if path.is_dir()}
    if directories != {"image", "wheel"}:
        raise RuntimeError("release candidate directory layout is invalid")
    wheel_names = sorted(name for name in files if name.startswith("wheel/") and name.endswith(".whl"))
    image_names = sorted(name for name in files if name.startswith("image/") and name.endswith(".tar"))
    if len(wheel_names) != 1 or image_names != ["image/alma3-3.0.0-cpu.tar"]:
        raise RuntimeError("release candidate payload layout is invalid")
    payloads = {"acceptance.json", wheel_names[0], image_names[0]}
    if files != payloads | {"SHA256SUMS.json", CANDIDATE_MARKER}:
        raise RuntimeError("release candidate file set is invalid")
    if (candidate / CANDIDATE_MARKER).read_bytes() != b"complete\n":
        raise RuntimeError("release candidate completion marker is invalid")
    try:
        manifest = json.loads((candidate / "SHA256SUMS.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError("release candidate checksum manifest is invalid") from error
    if not isinstance(manifest, dict) or set(manifest) != payloads:
        raise RuntimeError("release candidate checksum entries are invalid")
    for name, expected in manifest.items():
        if not isinstance(expected, str) or _sha256(candidate / name) != expected:
            raise RuntimeError(f"release candidate checksum mismatch: {name}")
    try:
        acceptance = json.loads((candidate / "acceptance.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError("release candidate acceptance record is invalid") from error
    if (
        not isinstance(acceptance, dict)
        or acceptance.get("kind") != CANDIDATE_KIND
        or acceptance.get("schema_version") != CANDIDATE_SCHEMA_VERSION
        or acceptance.get("status") != "passed"
    ):
        raise RuntimeError("release candidate acceptance record has the wrong contract")
    if acceptance.get("wheel", {}).get("sha256") != manifest[wheel_names[0]]:
        raise RuntimeError("release candidate wheel binding is invalid")
    image = acceptance.get("image", {})
    if image.get("archive_sha256") != manifest[image_names[0]]:
        raise RuntimeError("release candidate image archive binding is invalid")
    if _archive_config_id(candidate / image_names[0]) != image.get("archive_config_id"):
        raise RuntimeError("release candidate Docker archive config ID is invalid")
    inspect_wheel(candidate / wheel_names[0])
    return acceptance


def _expected_candidate_name(source: dict[str, Any], release_identity: dict[str, Any]) -> str:
    return f"alma3-3.0.0-rc-{source['commit'][:8]}-{release_identity['manifest_sha256'][:8]}"


def _seal_candidate(
    output: Path,
    *,
    wheel: Path,
    image_tag: str,
    source: dict[str, Any],
    source_contract: str,
    release: Path,
    release_identity: dict[str, Any],
    citation: str,
) -> None:
    expected_name = _expected_candidate_name(source, release_identity)
    if output.name != expected_name:
        raise RuntimeError(f"release candidate output must end with {expected_name}")
    output_resolved = output.resolve()
    if output_resolved == ROOT or output_resolved.is_relative_to(ROOT):
        raise RuntimeError("release candidate output must be outside the source checkout")
    if output_resolved == release or output_resolved.is_relative_to(release):
        raise RuntimeError("release candidate output must be outside the release artifact")

    image_identity = _image_identity(image_tag)
    with _atomic_candidate(output) as temporary:
        wheel_output = temporary / "wheel" / wheel.name
        wheel_sha256 = _copy_new(wheel, wheel_output)
        image_output = temporary / "image" / "alma3-3.0.0-cpu.tar"
        image_output.parent.mkdir(parents=True)
        run(["docker", "image", "save", "--output", str(image_output), image_tag])
        with image_output.open("rb") as handle:
            os.fsync(handle.fileno())
        _fsync_directory(wheel_output.parent)
        _fsync_directory(image_output.parent)
        image_archive_sha256 = _sha256(image_output)
        archive_config_id = _archive_config_id(image_output)
        run(["docker", "image", "load", "--input", str(image_output)])
        if _image_identity(image_tag) != image_identity:
            raise RuntimeError("saved Docker archive differs from the tested image")

        acceptance = {
            "citation": citation,
            "image": {
                **image_identity,
                "archive_config_id": archive_config_id,
                "archive_bytes": image_output.stat().st_size,
                "archive_sha256": image_archive_sha256,
                "archive_round_trip_verified": True,
                "cpu_only": True,
                "embedded_release_verified": True,
                "network_disabled_demo_passed": True,
            },
            "kind": CANDIDATE_KIND,
            "publication": {
                "aws": False,
                "container_registry": False,
                "model_hosting": False,
                "pypi": False,
            },
            "release": release_identity,
            "runtime_contract_sha256": source_contract,
            "schema_version": CANDIDATE_SCHEMA_VERSION,
            "source": source,
            "status": "passed",
            "verification": {
                "docker_matrix": sorted(PYTHON_IMAGES),
                "lint_passed": True,
                "unit_tests_passed": True,
            },
            "wheel": {
                "bytes": wheel_output.stat().st_size,
                "filename": wheel.name,
                "sha256": wheel_sha256,
                "weight_free": True,
            },
        }
        _write_new(temporary / "acceptance.json", _canonical_json(acceptance))
        checksums = {
            "acceptance.json": _sha256(temporary / "acceptance.json"),
            f"image/{image_output.name}": image_archive_sha256,
            f"wheel/{wheel_output.name}": wheel_sha256,
        }
        _write_new(temporary / "SHA256SUMS.json", _canonical_json(checksums))
        for name, expected in checksums.items():
            if _sha256(temporary / name) != expected:
                raise RuntimeError(f"release candidate checksum mismatch before publication: {name}")

        if _source_identity() != source or runtime_contract(ROOT / "src" / "alma3") != source_contract:
            raise RuntimeError("source checkout changed during the release gate")
        if _release_identity(release) != release_identity:
            raise RuntimeError("release artifact changed during the release gate")
        if _citation_value() != citation:
            raise RuntimeError("README citation changed during the release gate")
        if _image_identity(image_tag) != image_identity:
            raise RuntimeError("tested Docker image changed before publication")

        _write_new(temporary / CANDIDATE_MARKER, b"complete\n")
        _verify_candidate(temporary)


def main() -> int:
    parser = argparse.ArgumentParser(description="Run the local ALMA3 release gate.")
    parser.add_argument("--release-artifact", type=Path)
    parser.add_argument("--output", type=Path, help="Preserve the exact tested wheel and standalone image")
    parser.add_argument("--skip-docker-matrix", action="store_true")
    args = parser.parse_args()
    if args.output is not None and args.release_artifact is None:
        parser.error("--output requires --release-artifact")
    if args.output is not None and args.skip_docker_matrix:
        parser.error("a preserved release candidate requires the complete Docker matrix")
    if args.output is not None:
        args.output = args.output.resolve()

    source_identity = None
    release_identity = None
    citation = None
    if args.output is not None:
        source_identity = _source_identity()
        release_identity = _release_identity(args.release_artifact.resolve())
        citation = _citation_value()
        expected_name = _expected_candidate_name(source_identity, release_identity)
        if args.output.name != expected_name:
            parser.error(f"--output must end with {expected_name}")
        if args.output.exists() or args.output.is_symlink():
            parser.error(f"--output already exists: {args.output}")

    environment = os.environ.copy()
    environment["PYTHONPATH"] = str(ROOT / "src")
    ruff = shutil.which("ruff")
    if args.output is not None and ruff is None:
        raise RuntimeError("a preserved release candidate requires ruff")
    if ruff:
        run([ruff, "check", "src", "tests"])
    run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"], env=environment)

    with tempfile.TemporaryDirectory(prefix="alma3-release-gate-") as raw:
        source_contract = runtime_contract(ROOT / "src" / "alma3")
        wheel_dir = Path(raw) / "wheel"
        wheel_dir.mkdir()
        run(
            [
                sys.executable,
                "-m",
                "pip",
                "wheel",
                "--no-deps",
                "--no-build-isolation",
                "--wheel-dir",
                str(wheel_dir),
                ".",
            ]
        )
        wheels = list(wheel_dir.glob("alma3-3.0.0-*.whl"))
        if len(wheels) != 1:
            raise RuntimeError("release gate did not build exactly one ALMA3 3.0.0 wheel")
        inspect_wheel(wheels[0])
        wheel_root = Path(raw) / "wheel-root"
        with zipfile.ZipFile(wheels[0]) as archive:
            archive.extractall(wheel_root)
        wheel_contract = runtime_contract(wheel_root / "alma3")
        if wheel_contract != source_contract:
            raise RuntimeError(
                f"wheel runtime contract differs from source: {wheel_contract} != {source_contract}"
            )

        if not args.skip_docker_matrix:
            for version, image in PYTHON_IMAGES.items():
                tag = f"alma3-runtime:3.0.0-py{version.replace('.', '')}-rc"
                command = ["docker", "build", "--target", "runtime", "-t", tag]
                if image is not None:
                    command.extend(["--build-arg", f"PYTHON_IMAGE={image}"])
                command.append(".")
                run(command)
                run(
                    [
                        "docker",
                        "run",
                        "--rm",
                        "--user",
                        "0:0",
                        "--entrypoint",
                        "sh",
                        "-e",
                        f"ALMA3_RUNTIME_CONTRACT_SHA256={source_contract}",
                        "-v",
                        f"{wheel_dir}:/wheel:ro",
                        tag,
                        "-c",
                        (
                            "python -m pip uninstall -y alma3 >/dev/null && "
                            "python -m pip install --no-deps /wheel/alma3-3.0.0-*.whl >/dev/null && "
                            "alma3 --version && python -m alma3 --version && "
                            "python -c 'import os; from alma3.hashes import runtime_contract_sha256; "
                            "actual = runtime_contract_sha256(); "
                            "expected = os.environ[\"ALMA3_RUNTIME_CONTRACT_SHA256\"]; "
                            "assert actual == expected, (actual, expected)'"
                        ),
                    ]
                )

        if args.release_artifact is not None:
            release = args.release_artifact.resolve()
            output_user = f"{os.getuid()}:{os.getgid()}"
            inspect_release_catalog(release)
            inspect_demo(release)
            image_tag = (
                f"alma3:3.0.0-rc-{source_identity['commit'][:8]}-"
                f"{release_identity['manifest_sha256'][:8]}"
                if source_identity is not None and release_identity is not None
                else "alma3:3.0.0-rc"
            )
            run(
                [
                    "docker",
                    "build",
                    "--build-context",
                    f"alma3_release={release}",
                    "-t",
                    image_tag,
                    ".",
                ]
            )
            run(["docker", "run", "--rm", "--network", "none", image_tag, "verify-release"])
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--network",
                    "none",
                    "--entrypoint",
                    "python",
                    "-e",
                    f"ALMA3_RUNTIME_CONTRACT_SHA256={source_contract}",
                    image_tag,
                    "-c",
                    (
                        "import os; from alma3.hashes import runtime_contract_sha256; "
                        "actual = runtime_contract_sha256(); "
                        "expected = os.environ['ALMA3_RUNTIME_CONTRACT_SHA256']; "
                        "assert actual == expected, (actual, expected)"
                    ),
                ]
            )
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--network",
                    "none",
                    "--user",
                    output_user,
                    "--workdir",
                    "/out",
                    "-v",
                    f"{raw}:/out",
                    image_tag,
                    "demo",
                ]
            )
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--network",
                    "none",
                    "--user",
                    output_user,
                    "-v",
                    f"{raw}:/out",
                    image_tag,
                    "demo",
                    "-o",
                    "/out/alma3-demo.jsonl",
                ]
            )
            inspect_paired_results(
                Path(raw) / "alma3-demo.jsonl",
                Path(raw) / "alma3-demo.csv",
                ROOT / "src" / "alma3" / "examples" / "example_dataset.manifest.json",
            )
            if args.output is not None:
                assert source_identity is not None
                assert release_identity is not None
                assert citation is not None
                _seal_candidate(
                    args.output,
                    wheel=wheels[0],
                    image_tag=image_tag,
                    source=source_identity,
                    source_contract=source_contract,
                    release=release,
                    release_identity=release_identity,
                    citation=citation,
                )
    print("ALMA3 release gate passed", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
