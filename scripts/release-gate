#!/usr/bin/env python3
from __future__ import annotations

import argparse
import csv
import gzip
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
FORBIDDEN_NAMES = {".safetensors", ".pt", ".pth", ".h5", ".hdf5"}
FORBIDDEN_TEXT = (b"/home/", b"/data/", b"pac" + b"map", b"fai" + b"ss")
PYTHON_IMAGES = {
    "3.10": "python:3.10-slim-bookworm",
    "3.11": "python:3.11-slim-bookworm",
    "3.12": None,
}
DEMO_SHA256 = "172ddb11f799ccc7952c5f4a86e8babefba99a685e92ec014a46a531b49227a6"


def run(command: list[str], *, env: dict[str, str] | None = None) -> None:
    print("+", " ".join(command), flush=True)
    subprocess.run(command, cwd=ROOT, env=env, check=True)


def inspect_wheel(wheel: Path) -> None:
    with zipfile.ZipFile(wheel) as archive:
        names = {info.filename for info in archive.infolist()}
        if "alma3/py.typed" not in names:
            raise RuntimeError("wheel is missing the PEP 561 marker")
        if "alma3/examples/example_dataset.csv.gz" not in names:
            raise RuntimeError("wheel is missing the packaged demo")
        for info in archive.infolist():
            name = info.filename.lower()
            if Path(name).suffix in FORBIDDEN_NAMES:
                raise RuntimeError(f"wheel contains forbidden binary: {info.filename}")
            if info.file_size <= 2 * 1024 * 1024:
                content = archive.read(info).lower()
                for forbidden in FORBIDDEN_TEXT:
                    if forbidden in content:
                        raise RuntimeError(f"wheel contains forbidden text {forbidden!r}: {info.filename}")


def runtime_contract(package_root: Path) -> str:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.hashes import runtime_contract_sha256

    return runtime_contract_sha256(package_root)


def inspect_paired_results(jsonl: Path, csv_path: Path) -> None:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.clinical_result import validate_result
    from alma3.infer import _RESULT_CSV_FIELDS, _result_csv_row

    json_rows = [
        json.loads(line)
        for line in jsonl.read_text(encoding="utf-8").splitlines()
    ]
    with csv_path.open(encoding="utf-8", newline="") as handle:
        reader = csv.DictReader(handle)
        csv_rows = list(reader)
    if tuple(reader.fieldnames or ()) != _RESULT_CSV_FIELDS:
        raise RuntimeError("paired demo CSV header does not match the 44-column contract")
    if not json_rows or len(json_rows) != len(csv_rows):
        raise RuntimeError("paired demo outputs are empty or have different row counts")
    for row in json_rows:
        validate_result(row)
    expected_csv_rows = [
        {
            field: "" if value == "" else str(value)
            for field, value in _result_csv_row(row).items()
        }
        for row in json_rows
    ]
    if expected_csv_rows != csv_rows:
        raise RuntimeError("paired JSONL and CSV demo results are inconsistent")


def inspect_release_catalog(release: Path) -> None:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.download import _release_spec, _validate_catalog_files
    from alma3.release import validate_release

    _validate_catalog_files(release, _release_spec())
    validate_release(release, device="cpu", load_model=False)


def inspect_demo(release: Path) -> None:
    sys.path.insert(0, str(ROOT / "src"))
    from alma3.infer import _array_csv_batches, demo_path
    from alma3.release import validate_release

    digest = hashlib.sha256()
    with gzip.open(demo_path(), "rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    if digest.hexdigest() != DEMO_SHA256:
        raise RuntimeError("packaged demo does not match the ALMA v2 dataset")

    validated = validate_release(release, device="cpu", load_model=False)
    with gzip.open(demo_path(), "rt", encoding="utf-8", newline="") as handle:
        header = next(csv.reader(handle))
    recognized = len(set(header[1:]) & set(validated["cpg"].cpg_ids))
    if recognized != 48_478:
        raise RuntimeError(f"packaged demo matches {recognized} release CpGs; expected 48478")
    summaries = [
        summary
        for *_batch, summary in _array_csv_batches(
            demo_path(),
            validated["cpg"],
            input_values="beta",
            minimum_observed_cpgs=int(validated["thresholds"]["minimum_observed_cpgs"]),
        )
    ]
    observed = sum(summary.observed for summary in summaries)
    clipped = sum(summary.clipped for summary in summaries)
    if (observed, clipped) != (484_780, 5_012):
        raise RuntimeError(
            f"packaged demo adjustment is {(observed, clipped)}; expected (484780, 5012)"
        )


def main() -> int:
    parser = argparse.ArgumentParser(description="Run the local ALMA3 release gate.")
    parser.add_argument("--release-artifact", type=Path)
    parser.add_argument("--skip-docker-matrix", action="store_true")
    args = parser.parse_args()

    environment = os.environ.copy()
    environment["PYTHONPATH"] = str(ROOT / "src")
    ruff = shutil.which("ruff")
    if ruff:
        run([ruff, "check", "src", "tests"])
    run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"], env=environment)

    with tempfile.TemporaryDirectory(prefix="alma3-release-gate-") as raw:
        source_contract = runtime_contract(ROOT / "src" / "alma3")
        wheel_dir = Path(raw) / "wheel"
        wheel_dir.mkdir()
        run(
            [
                sys.executable,
                "-m",
                "pip",
                "wheel",
                "--no-deps",
                "--no-build-isolation",
                "--wheel-dir",
                str(wheel_dir),
                ".",
            ]
        )
        wheels = list(wheel_dir.glob("alma3-3.0.0-*.whl"))
        if len(wheels) != 1:
            raise RuntimeError("release gate did not build exactly one ALMA3 3.0.0 wheel")
        inspect_wheel(wheels[0])
        wheel_root = Path(raw) / "wheel-root"
        with zipfile.ZipFile(wheels[0]) as archive:
            archive.extractall(wheel_root)
        wheel_contract = runtime_contract(wheel_root / "alma3")
        if wheel_contract != source_contract:
            raise RuntimeError(
                f"wheel runtime contract differs from source: {wheel_contract} != {source_contract}"
            )

        if not args.skip_docker_matrix:
            for version, image in PYTHON_IMAGES.items():
                tag = f"alma3-runtime:3.0.0-py{version.replace('.', '')}-rc"
                command = ["docker", "build", "--target", "runtime", "-t", tag]
                if image is not None:
                    command.extend(["--build-arg", f"PYTHON_IMAGE={image}"])
                command.append(".")
                run(command)
                run(
                    [
                        "docker",
                        "run",
                        "--rm",
                        "--user",
                        "0:0",
                        "--entrypoint",
                        "sh",
                        "-e",
                        f"ALMA3_RUNTIME_CONTRACT_SHA256={source_contract}",
                        "-v",
                        f"{wheel_dir}:/wheel:ro",
                        tag,
                        "-c",
                        (
                            "python -m pip uninstall -y alma3 >/dev/null && "
                            "python -m pip install --no-deps /wheel/alma3-3.0.0-*.whl >/dev/null && "
                            "alma3 --version && python -m alma3 --version && "
                            "python -c 'import os; from alma3.hashes import runtime_contract_sha256; "
                            "actual = runtime_contract_sha256(); "
                            "expected = os.environ[\"ALMA3_RUNTIME_CONTRACT_SHA256\"]; "
                            "assert actual == expected, (actual, expected)'"
                        ),
                    ]
                )

        if args.release_artifact is not None:
            release = args.release_artifact.resolve()
            inspect_release_catalog(release)
            inspect_demo(release)
            run(
                [
                    "docker",
                    "build",
                    "--build-context",
                    f"alma3_release={release}",
                    "-t",
                    "alma3:3.0.0-rc",
                    ".",
                ]
            )
            run(["docker", "run", "--rm", "alma3:3.0.0-rc", "verify-release"])
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--entrypoint",
                    "python",
                    "-e",
                    f"ALMA3_RUNTIME_CONTRACT_SHA256={source_contract}",
                    "alma3:3.0.0-rc",
                    "-c",
                    (
                        "import os; from alma3.hashes import runtime_contract_sha256; "
                        "actual = runtime_contract_sha256(); "
                        "expected = os.environ['ALMA3_RUNTIME_CONTRACT_SHA256']; "
                        "assert actual == expected, (actual, expected)"
                    ),
                ]
            )
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--user",
                    "0:0",
                    "-v",
                    f"{raw}:/out",
                    "alma3:3.0.0-rc",
                    "demo",
                    "-o",
                    "/out/alma3-demo.jsonl",
                ]
            )
            run(
                [
                    "docker",
                    "run",
                    "--rm",
                    "--user",
                    "0:0",
                    "-v",
                    f"{raw}:/out",
                    "alma3:3.0.0-rc",
                    "demo",
                    "-o",
                    "/out/alma3-demo.csv",
                ]
            )
            inspect_paired_results(
                Path(raw) / "alma3-demo.jsonl",
                Path(raw) / "alma3-demo.csv",
            )
    print("ALMA3 release gate passed", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
