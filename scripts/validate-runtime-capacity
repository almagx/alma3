#!/usr/bin/env python3
"""Run a local ALMA3 CPU or GPU capacity check and write one acceptance record."""

from __future__ import annotations

import argparse
import csv
import gzip
import hashlib
import json
import math
import os
import platform
import resource
import tempfile
import time
from pathlib import Path
from typing import Any

import torch

from alma3.infer import demo_path, run_inference
from alma3.release import validate_release
from alma3.runtime import ALMA3, DEFAULT_BATCH_SIZE

RECORD_KIND = "alma3_runtime_capacity_validation"
RECORD_SCHEMA_VERSION = 1
CLINICAL_COMPARISON_TOLERANCE = 1e-5
EMBEDDING_COMPARISON_TOLERANCE = 1e-4
GPU_STABILITY_WINDOW = 20
GPU_STABILITY_ALLOWANCE_BYTES = 256 * 1024**2


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _demo_sha256() -> str:
    digest = hashlib.sha256()
    with gzip.open(demo_path(), "rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _write_demo_workload(path: Path, sample_count: int) -> list[str]:
    with gzip.open(demo_path(), "rt", encoding="utf-8", newline="") as handle:
        reader = csv.reader(handle)
        header = next(reader)
        rows = list(reader)
    if not rows:
        raise RuntimeError("packaged demo contains no samples")
    sample_ids = [f"capacity-{index + 1:04d}" for index in range(sample_count)]
    with path.open("x", encoding="utf-8", newline="") as handle:
        writer = csv.writer(handle, lineterminator="\n")
        writer.writerow(header)
        for index, sample_id in enumerate(sample_ids):
            writer.writerow([sample_id, *rows[index % len(rows)][1:]])
    return sample_ids


def _write_bedmethyl_workload(path: Path, artifact: Path) -> list[str]:
    validated = validate_release(artifact, device="cpu", load_model=False)
    cpg = validated["cpg"]
    if cpg.chrom is None or cpg.start is None:
        raise RuntimeError("release CpG manifest does not support BedMethyl")
    minimum = int(validated["thresholds"]["minimum_observed_cpgs"])
    observed = 0
    row_number = 0
    seen: set[tuple[str, int]] = set()
    with path.open("x", encoding="utf-8", newline="") as handle:
        writer = csv.writer(handle, delimiter="\t", lineterminator="\n")
        for chrom, start in zip(cpg.chrom, cpg.start, strict=True):
            coordinate = (chrom, start)
            if coordinate in seen:
                continue
            seen.add(coordinate)
            fraction = (row_number * 37) % 101
            writer.writerow(
                [chrom, start, start + 1, ".", 0, ".", start, start + 1, 0, 20, fraction]
            )
            observed += len(cpg.coordinate_index[coordinate])
            row_number += 1
            if observed >= minimum:
                break
    if observed < minimum:
        raise RuntimeError("release does not contain enough BedMethyl coordinates")
    return [path.stem]


def _current_rss_bytes() -> int:
    status = Path("/proc/self/status")
    if status.is_file():
        for line in status.read_text(encoding="utf-8").splitlines():
            if line.startswith("VmRSS:"):
                return int(line.split()[1]) * 1024
    return 0


def _assert_finite(value: Any, path: str = "record") -> None:
    if isinstance(value, dict):
        for key, child in value.items():
            _assert_finite(child, f"{path}.{key}")
    elif isinstance(value, list):
        for index, child in enumerate(value):
            _assert_finite(child, f"{path}[{index}]")
    elif isinstance(value, float) and not math.isfinite(value):
        raise RuntimeError(f"non-finite value at {path}")


def _compare(
    left: Any,
    right: Any,
    path: str,
    differences: list[float],
    *,
    tolerance: float,
) -> None:
    if type(left) is not type(right):
        raise RuntimeError(f"CPU/GPU type mismatch at {path}")
    if isinstance(left, dict):
        if set(left) != set(right):
            raise RuntimeError(f"CPU/GPU field mismatch at {path}")
        for key in sorted(left):
            _compare(left[key], right[key], f"{path}.{key}", differences, tolerance=tolerance)
    elif isinstance(left, list):
        if len(left) != len(right):
            raise RuntimeError(f"CPU/GPU length mismatch at {path}")
        for index, (left_value, right_value) in enumerate(zip(left, right, strict=True)):
            _compare(left_value, right_value, f"{path}[{index}]", differences, tolerance=tolerance)
    elif isinstance(left, float):
        difference = abs(left - right)
        differences.append(difference)
        if difference > tolerance:
            raise RuntimeError(
                f"CPU/GPU numeric mismatch at {path}: {difference:g} exceeds {tolerance:g}"
            )
    elif left != right:
        raise RuntimeError(f"CPU/GPU value mismatch at {path}: {left!r} != {right!r}")


def _publish_json(path: Path, payload: dict[str, Any]) -> None:
    if path.exists():
        raise FileExistsError(f"acceptance record already exists: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, raw_temporary = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    temporary = Path(raw_temporary)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, sort_keys=True, separators=(",", ":"), allow_nan=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.link(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _configure_cuda(device: str, limit_gib: float | None) -> dict[str, Any] | None:
    resolved = torch.device(device)
    if resolved.type != "cuda":
        return None
    index = torch.cuda.current_device() if resolved.index is None else resolved.index
    torch.cuda.set_device(index)
    properties = torch.cuda.get_device_properties(index)
    limit_bytes = None
    if limit_gib is not None:
        limit_bytes = int(limit_gib * 1024**3)
        if limit_bytes <= 0 or limit_bytes > properties.total_memory:
            raise ValueError("CUDA memory limit must be positive and no larger than device memory")
        torch.cuda.set_per_process_memory_fraction(limit_bytes / properties.total_memory, index)
    torch.cuda.empty_cache()
    torch.cuda.reset_peak_memory_stats(index)
    free, total = torch.cuda.mem_get_info(index)
    return {
        "index": index,
        "name": properties.name,
        "compute_capability": f"{properties.major}.{properties.minor}",
        "total_memory_bytes": total,
        "available_memory_bytes_before_load": free,
        "allocator_limit_bytes": limit_bytes,
    }


def _run(args: argparse.Namespace) -> dict[str, Any]:
    artifact = args.artifact.resolve()
    if args.threads is not None:
        torch.set_num_threads(args.threads)
        torch.set_num_interop_threads(1)
    cuda = _configure_cuda(args.device, args.cuda_memory_limit_gib)
    batch_memory: list[dict[str, int]] = []
    original_predict = ALMA3._predict_tensors

    def measured_predict(self: ALMA3, *values: Any, **keywords: Any):
        predicted = original_predict(self, *values, **keywords)
        record = {
            "samples": len(values[0]),
            "rss_bytes": _current_rss_bytes(),
        }
        if self.device.type == "cuda":
            torch.cuda.synchronize(self.device)
            record.update(
                {
                    "cuda_allocated_bytes": torch.cuda.memory_allocated(self.device),
                    "cuda_reserved_bytes": torch.cuda.memory_reserved(self.device),
                }
            )
        batch_memory.append(record)
        return predicted

    with tempfile.TemporaryDirectory(prefix="alma3-capacity-") as raw:
        root = Path(raw)
        if args.input_kind == "demo":
            input_path = root / "input.csv"
            sample_ids = _write_demo_workload(input_path, args.samples)
            input_format = "array-csv"
        else:
            input_path = root / "synthetic-bedmethyl.bed"
            sample_ids = _write_bedmethyl_workload(input_path, artifact)
            input_format = "bedmethyl"
        input_sha256 = _sha256(input_path)
        output = root / "results.jsonl"
        sidecar = root / "embeddings.json"
        started = time.monotonic()
        ALMA3._predict_tensors = measured_predict
        try:
            run_inference(
                artifact,
                input_path,
                input_format,
                output,
                device=args.device,
                embedding_sidecar=sidecar,
                batch_size=args.batch_size,
            )
        finally:
            ALMA3._predict_tensors = original_predict
        elapsed_seconds = time.monotonic() - started
        results = [json.loads(line) for line in output.read_text(encoding="utf-8").splitlines()]
        sidecar_payload = json.loads(sidecar.read_text(encoding="utf-8"))

    result_ids = [result["sample_id"] for result in results]
    sidecar_ids = [sample["sample_id"] for sample in sidecar_payload["samples"]]
    if result_ids != sample_ids or sidecar_ids != sample_ids:
        raise RuntimeError("inference did not preserve workload sample order")
    _assert_finite(results, "results")
    _assert_finite(sidecar_payload, "sidecar")

    stability: dict[str, Any] | None = None
    if cuda is not None:
        reserved = [record["cuda_reserved_bytes"] for record in batch_memory]
        window = reserved[-min(len(reserved), GPU_STABILITY_WINDOW) :]
        spread = max(window) - min(window)
        stable = len(batch_memory) < GPU_STABILITY_WINDOW or spread <= GPU_STABILITY_ALLOWANCE_BYTES
        if not stable:
            raise RuntimeError(f"CUDA reserved memory grew by {spread:,} bytes in the final validation window")
        stability = {
            "window_batches": len(window),
            "reserved_memory_spread_bytes": spread,
            "allowance_bytes": GPU_STABILITY_ALLOWANCE_BYTES,
            "stable": True,
        }

    comparison = None
    if args.reference is not None:
        reference = json.loads(args.reference.read_text(encoding="utf-8"))
        if reference.get("kind") != RECORD_KIND or reference.get("schema_version") != RECORD_SCHEMA_VERSION:
            raise RuntimeError("reference acceptance record has the wrong schema")
        clinical_differences: list[float] = []
        embedding_differences: list[float] = []
        _compare(
            reference["outputs"]["results"],
            results,
            "results",
            clinical_differences,
            tolerance=CLINICAL_COMPARISON_TOLERANCE,
        )
        _compare(
            reference["outputs"]["sidecar"],
            sidecar_payload,
            "sidecar",
            embedding_differences,
            tolerance=EMBEDDING_COMPARISON_TOLERANCE,
        )
        comparison = {
            "reference_sha256": _sha256(args.reference),
            "clinical_tolerance": CLINICAL_COMPARISON_TOLERANCE,
            "clinical_maximum_absolute_difference": max(clinical_differences, default=0.0),
            "embedding_tolerance": EMBEDDING_COMPARISON_TOLERANCE,
            "embedding_maximum_absolute_difference": max(embedding_differences, default=0.0),
            "passed": True,
        }

    peak_rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024
    record = {
        "kind": RECORD_KIND,
        "schema_version": RECORD_SCHEMA_VERSION,
        "passed": True,
        "environment": {
            "python": platform.python_version(),
            "platform": platform.platform(),
            "machine": platform.machine(),
            "logical_cpu_count": os.cpu_count(),
            "torch": str(torch.__version__),
            "torch_threads": torch.get_num_threads(),
            "torch_interop_threads": torch.get_num_interop_threads(),
            "mkl_enabled": "USE_MKL=ON" in torch.__config__.show(),
            "cuda_runtime": torch.version.cuda,
            "cuda": cuda,
        },
        "workload": {
            "kind": args.input_kind,
            "sample_count": len(sample_ids),
            "batch_size": args.batch_size,
            "packaged_demo_sha256": _demo_sha256(),
            "input_sha256": input_sha256,
        },
        "memory": {
            "peak_rss_bytes": peak_rss,
            "batches": batch_memory,
            "cuda_peak_allocated_bytes": (
                torch.cuda.max_memory_allocated(cuda["index"]) if cuda is not None else None
            ),
            "cuda_peak_reserved_bytes": (
                torch.cuda.max_memory_reserved(cuda["index"]) if cuda is not None else None
            ),
            "cuda_stability": stability,
        },
        "elapsed_seconds": elapsed_seconds,
        "comparison": comparison,
        "outputs": {"results": results, "sidecar": sidecar_payload},
    }
    return record


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate ALMA3 CPU or GPU capacity.")
    parser.add_argument("--artifact", type=Path, required=True)
    parser.add_argument("--device", required=True)
    parser.add_argument("--input-kind", choices=["demo", "bedmethyl"], default="demo")
    parser.add_argument("--samples", type=int, default=10)
    parser.add_argument("--batch-size", type=int, default=DEFAULT_BATCH_SIZE)
    parser.add_argument("--threads", type=int)
    parser.add_argument("--cuda-memory-limit-gib", type=float)
    parser.add_argument("--reference", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if args.samples <= 0:
        parser.error("--samples must be positive")
    if args.batch_size <= 0:
        parser.error("--batch-size must be positive")
    if args.input_kind == "bedmethyl" and args.samples != 1:
        parser.error("BedMethyl validation requires --samples 1")
    if args.threads is not None and args.threads <= 0:
        parser.error("--threads must be positive")
    if args.cuda_memory_limit_gib is not None and not args.device.startswith("cuda"):
        parser.error("--cuda-memory-limit-gib requires a CUDA device")
    record = _run(args)
    _publish_json(args.output, record)
    print(f"ALMA3 capacity validation passed: {args.output}", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
